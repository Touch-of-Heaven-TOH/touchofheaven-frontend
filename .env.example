# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local - it is already covered by .gitignore.

# Public URL for this frontend. In the split local setup the backend usually
# runs on 3000 and the frontend on 3001.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Base URL of the Backend-of-TOH API this app talks to.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional server-to-server backend origin. Leave blank locally unless the
# server-rendered frontend should call a different private backend URL.
BACKEND_INTERNAL_API_URL=

# Stripe publishable key only. Never place Stripe secret keys in frontend env.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Maps JavaScript API key, client-side, restricted to this app's
# domain(s) in the Google Cloud Console. Used by the braider discovery map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID from the Google Cloud Console (Google Maps Platform > Map Management).
# Required for google.maps.marker.AdvancedMarkerElement (custom photo pins) -
# the map will not render without this even if the API key above is valid.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
