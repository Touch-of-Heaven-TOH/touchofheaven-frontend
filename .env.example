# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local — it is already covered by .gitignore.

# Base URL of the Backend-of-TOH API this app talks to.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Maps JavaScript API key, client-side, restricted to this app's
# domain(s) in the Google Cloud Console. Used by the braider discovery map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
